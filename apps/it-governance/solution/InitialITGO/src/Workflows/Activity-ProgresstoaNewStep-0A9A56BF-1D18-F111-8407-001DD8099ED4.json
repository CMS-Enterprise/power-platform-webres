          "type": "Compose",
          "inputs": "@json('{\n  \"971270000\":\"Your Intake Request is under review by the Governance Team.\",\n  \"971270001\":\"The Governance Team has requested a draft Business Case.\",\n  \"100000001\":\"A GRT Meeting is being scheduled.\",\n  \"971270002\":\"A GRT Meeting regarding this Intake Request is in progress.\",\n  \"971270008\":\"An LCID is currently being processed for your Intake Request.\",\n  \"971270003\":\"Administrators have requested a Final Business Case.\",\n  \"100000002\":\"A GRB Review is being scheduled.\",\n  \"100000003\":\"Business Case edits have been requested.\",\n  \"971270004\":\"The admin team is awaiting the results of the GRB Review.\",\n  \"971270005\":\"The Governance Review Board is reviewing the final Business case and recommendations.\",\n  \"971270009\":\"Your Intake Request has been marked as Finished.\"\n}')"
        },
