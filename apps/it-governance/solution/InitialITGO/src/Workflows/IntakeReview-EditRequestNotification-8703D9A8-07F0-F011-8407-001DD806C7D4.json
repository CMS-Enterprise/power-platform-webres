                "operationMetadataId": "80227d63-e4dc-41b3-be68-9d1ddcaddcec"
              },
              "type": "Compose",
              "inputs": "@string(outputs('Tokens'))"
            },
            "Run_a_Child_Flow": {
              "runAfter": {
                "StringTokens": [
                  "Succeeded"
                ]
              },
              "metadata": {
                "operationMetadataId": "a6ea51de-c5f8-4f11-8dfe-649b8e46564c"
              },
