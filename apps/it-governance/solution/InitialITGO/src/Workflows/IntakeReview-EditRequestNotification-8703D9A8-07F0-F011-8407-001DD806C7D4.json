              "inputs": {
                "host": {
                  "workflowReferenceName": "574e9e7e-a80e-f111-8407-001dd809993d"
                },
                "body": {
                  "text": "edit-request",
                  "text_1": "@outputs('StringTokens')"
                }
              }
