                },
                {
                  "key": "LifecycleExpiresAt",
                  "value": "@{outputs('Formatted_Expiration_Date')}"
                },
                {
                  "key": "LifecycleScope",
                  "value": "@{triggerOutputs()?['body/cr3ee_scope']}"
                },
                {
                  "key": "LifecycleCostBaseline",
                  "value": "@{triggerOutputs()?['body/cr3ee_costbaseline']}"
                },
                {
                  "key": "NextSteps",
                  "value": "@{items('Apply_to_each')?['cr3ee_nextsteps']}"
                },
                {
                  "key": "AdditionalInfo",
                  "value": "@{triggerOutputs()?['body/new_additionalinformation']}"
                },
                {
                  "key": "LCIDType",
                  "value": "@{triggerBody()?['_new_lcidtype_label']}"
                },
                {
                  "key": "LCIDLowIT",
                  "value": "@{triggerBody()?['_new_lcidislowit_label']}"
                },
                {
                  "key": "LCIDShortened",
                  "value": "@{triggerBody()?['_new_lcidisshortened_label']}"
                },
                {
                  "key": "LCIDComponent",
                  "value": "@{triggerBody()?['_new_lcidcomponent_label']}"
                }
              ]
            },
            "StringTokens": {
              "runAfter": {
                "Tokens": [
                  "Succeeded"
                ]
              },
              "metadata": {
                "operationMetadataId": "d764894a-965b-4104-8ee7-caa4dd27005a"
              },
              "type": "Compose",
              "inputs": "@string(outputs('Tokens'))"
            },
            "Run_a_Child_Flow": {
              "runAfter": {
                "StringTokens": [
                  "Succeeded"
                ]
              },
              "metadata": {
                "operationMetadataId": "32315638-5627-4f41-b263-757a7595382c"
              },
              "type": "Workflow",
              "inputs": {
                "host": {
                  "workflowReferenceName": "574e9e7e-a80e-f111-8407-001dd809993d"
                },
                "body": {
                  "text": "lcid-update",
                  "text_1": "@outputs('StringTokens')"
                }
              }
            },
            "Send_an_email_(V2)": {
              "runAfter": {
                "Run_a_Child_Flow": [
                  "Succeeded"
                ]
              },
              "metadata": {
                "operationMetadataId": "4bbfc0f8-d3cf-40c1-8c6f-2fa75e46cd00"
              },
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_office365",
                  "operationId": "SendEmailV2",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365"
                },
                "parameters": {
                  "emailMessage/To": "@outputs('Get_User')?['body/internalemailaddress']",
                  "emailMessage/Subject": "@body('Run_a_Child_Flow')?['emailsubject']",
                  "emailMessage/Body": "<p>@{body('Run_a_Child_Flow')?['emailbody']}</p>",
                  "emailMessage/Importance": "Normal"
                },
                "authentication": "@parameters('$authentication')"
              }
            }
          },
          "runAfter": {
            "List_rows": [
              "Succeeded"
            ]
          },
          "metadata": {
            "operationMetadataId": "bbebf29d-c437-4a1d-a974-aa01a4218045"
          },
          "type": "Foreach"
        },
        "Formatted_Issue_Date": {
          "runAfter": {
