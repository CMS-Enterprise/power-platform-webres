          "metadata": {
            "operationMetadataId": "f822be82-a414-4aa7-9c94-b09e82c4ec9a"
          },
          "type": "Compose",
          "inputs": "@formatDateTime(\n    convertTimeZone(triggerOutputs()?['body/cr69a_issuedat'],'UTC','Eastern Standard Time'),\n    'MMMM d, yyyy h:mm tt'\n)"
        },
        "Formatted_Expiration_Date": {
          "runAfter": {
