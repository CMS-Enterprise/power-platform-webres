            "parameters": {
              "emailMessage/To": "@parameters('Email Notification Recipients (new_EmailNotificationRecipients)')",
              "emailMessage/Subject": "@{body('Run_a_Child_Flow_2')?['emailsubject']}1",
              "emailMessage/Body": "<p>@{body('Run_a_Child_Flow_2')?['emailbody']}</p>",
              "emailMessage/Importance": "Normal"
            },
            "authentication": "@parameters('$authentication')"
          }
        },
        "Tokens_2": {
          "runAfter": {
            "Apply_to_each": [
              "Succeeded"
            ]
          },
          "metadata": {
            "operationMetadataId": "339f7009-7d3a-432b-be45-0d2d0f1ce347"
          },
          "type": "Compose",
          "inputs": [
            {
              "key": "LifecycleID",
              "value": "@{triggerOutputs()?['body/cr69a_lcid']}"
            },
            {
              "key": "LifecycleIssuedAt",
              "value": "@{outputs('Formatted_Issue_Date')}"
            },
            {
              "key": "ITGovernanceInboxAddress",
              "value": "@{parameters('IT Governance Team Email (new_ITGovernanceTeamEmail)')}"
            },
            {
              "key": "LifecycleExpiresAt",
              "value": "@{outputs('Formatted_Expiration_Date')}"
            },
            {
              "key": "LifecycleScope",
              "value": "@{triggerOutputs()?['body/cr3ee_scope']}"
            },
            {
              "key": "LifecycleCostBaseline",
              "value": "@{triggerOutputs()?['body/cr3ee_costbaseline']}"
            },
            {
              "key": "AdditionalInfo",
              "value": "@{triggerOutputs()?['body/new_additionalinformation']}"
            },
            {
              "key": "LCIDType",
              "value": "@{triggerBody()?['_new_lcidtype_label']}"
            },
            {
              "key": "LCIDLowIT",
              "value": "@{triggerBody()?['_new_lcidislowit_label']}"
            },
            {
              "key": "LCIDShortened",
              "value": "@{triggerBody()?['_new_lcidisshortened_label']}"
            },
            {
              "key": "LCIDComponent",
              "value": "@{triggerBody()?['_new_lcidcomponent_label']}"
            }
          ]
