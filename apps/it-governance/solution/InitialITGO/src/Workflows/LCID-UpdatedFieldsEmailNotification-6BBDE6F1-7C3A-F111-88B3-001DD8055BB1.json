          "metadata": {
            "operationMetadataId": "2bb104ca-5f33-48ae-a813-c23a9e810f7b"
          },
          "type": "Compose",
          "inputs": "@triggerOutputs()?['body']"
        },
        "List_rows": {
          "runAfter": {
            "Formatted_Expiration_Date": [
              "Succeeded"
            ]
          },
          "metadata": {
            "operationMetadataId": "a9bc2453-c6d0-4cd2-a2b4-ace8f9ee075f"
          },
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "connectionName": "shared_commondataserviceforapps",
              "operationId": "ListRecords",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
            },
            "parameters": {
              "entityName": "new_systemintakes",
              "$filter": "_cr69a_lcid_value eq @{triggerOutputs()?['body/cr69a_lifecycleidsid']}"
            },
            "authentication": "@parameters('$authentication')"
          }
        },
        "Apply_to_each": {
          "foreach": "@outputs('List_rows')?['body/value']",
          "actions": {
            "RequestLink": {
              "runAfter": {},
              "metadata": {
                "operationMetadataId": "ed6f8354-9ff3-47a7-8545-65b5b8747cb8"
              },
              "type": "Compose",
              "inputs": "@concat(\n  parameters('OrgBaseUrl (new_OrgBaseUrl)'),\n  '/main.aspx?appid=', parameters('AppId (new_AppId)'),\n  '&pagetype=entityrecord&etn=new_systemintake',\n  '&id=', items('Apply_to_each')?['new_systemintakeid']\n)"
            },
            "ReviewLink": {
              "runAfter": {
                "RequestLink": [
                  "Succeeded"
                ]
              },
              "metadata": {
                "operationMetadataId": "6f3cedcd-f73c-4aad-9e29-a032f287758a"
              },
              "type": "Compose",
              "inputs": "@concat(\n  parameters('OrgBaseUrl (new_OrgBaseUrl)'),\n  '/main.aspx?appid=', parameters('AppId (new_AppId)'),\n  '&pagetype=entityrecord&etn=cr69a_systemintakeadmin',\n  '&id=', items('Apply_to_each')?['_cr69a_systemintakereview_value']\n)"
            },
            "Get_User": {
              "runAfter": {
                "ReviewLink": [
                  "Succeeded"
                ]
              },
              "metadata": {
                "operationMetadataId": "8c84e781-8287-4c7b-b0eb-55b95e5a3aeb"
              },
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_commondataserviceforapps",
                  "operationId": "GetItem",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                },
                "parameters": {
                  "entityName": "systemusers",
                  "recordId": "@items('Apply_to_each')?['_ownerid_value']"
                },
                "authentication": "@parameters('$authentication')"
              }
            },
            "Tokens": {
              "runAfter": {
                "Get_User": [
                  "Succeeded"
                ]
              },
              "metadata": {
                "operationMetadataId": "e63b9e28-3087-4a43-b87b-8167524454fe"
              },
              "type": "Compose",
              "inputs": [
                {
                  "key": "LifecycleID",
                  "value": "@{triggerOutputs()?['body/cr69a_lcid']}"
