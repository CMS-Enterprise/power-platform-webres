          "defaultValue": "cooper.heinrichs@cms.hhs.gov",
          "type": "String",
          "metadata": {
            "schemaName": "new_EmailNotificationRecipients",
            "description": "The emails in this list will receive emails triggered by It Governance Request submissions and changes"
          }
